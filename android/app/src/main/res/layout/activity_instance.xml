<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="24dp">

            <!-- The game: its banner, faded, with the details on it. -->
            <com.google.android.material.card.MaterialCardView
                style="@style/DaoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- At least the banner's height, taller when the details need it. -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="140dp">

                    <ImageView
                        android:id="@+id/banner"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0.28"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceTitleLarge"
                            android:textColor="@color/dao_red_dark" />

                        <TextView
                            android:id="@+id/details"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/dao_ink" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Vulkan driver. -->
            <com.google.android.material.card.MaterialCardView
                style="@style/DaoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    style="@style/DaoCardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/DaoCardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_driver" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_driver_hint"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <Spinner
                        android:id="@+id/driver"
                        android:layout_width="match_parent"
                        android:layout_height="48dp" />

                    <!-- Only with "Custom driver" chosen. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/driver_pick"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_driver_pick"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Renderer: Xenia's emulation or the native renderer (games that have one). -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/renderer_card"
                style="@style/DaoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <LinearLayout
                    style="@style/DaoCardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/DaoCardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_renderer" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/renderer_hint"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <RadioGroup
                        android:id="@+id/renderer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/renderer_xenia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/renderer_xenia" />

                        <!-- Its text gets a green "NEW" tag (InstanceActivity). -->
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/renderer_native"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/renderer_native" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Frame rate cap: the game's own [video] frame_rate, read and written in place. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/fps_cap_card"
                style="@style/DaoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <LinearLayout
                    style="@style/DaoCardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/DaoCardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/fps_cap_label" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/fps_cap_hint"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <RadioGroup
                        android:id="@+id/fps_cap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/fps_cap_30"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="16dp"
                            android:text="@string/fps_cap_30" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/fps_cap_60"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="16dp"
                            android:text="@string/fps_cap_60" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/fps_cap_off"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fps_cap_off" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- The game's language. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/language_card"
                style="@style/DaoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <LinearLayout
                    style="@style/DaoCardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/DaoCardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_language" />

                    <!-- Its buttons are made from the game's Instance.languages(). -->
                    <RadioGroup
                        android:id="@+id/language"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Graphics. -->
            <com.google.android.material.card.MaterialCardView
                style="@style/DaoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    style="@style/DaoCardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/DaoCardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_graphics" />

                    <!-- Shown only when the package offers them (manifest "options"). -->
                    <TextView
                        android:id="@+id/preset_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/setting_preset"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:visibility="gone" />

                    <Spinner
                        android:id="@+id/preset"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/frame_rate_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/setting_frame_rate"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:visibility="gone" />

                    <Spinner
                        android:id="@+id/frame_rate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/setting_lod"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <RadioGroup
                        android:id="@+id/lod"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/lod_full"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/lod_full" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/lod_low"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/lod_low" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/lod_ultra_low"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/lod_ultra_low" />
                    </RadioGroup>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/setting_hud"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <RadioGroup
                        android:id="@+id/hud"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/hud_off"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_hud_off" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/hud_fps"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_hud_fps" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/hud_full"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_hud_full" />
                    </RadioGroup>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_hud_hint"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/vibrate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_vibrate" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Per-game touchscreen input mode. -->
            <com.google.android.material.card.MaterialCardView
                style="@style/DaoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    style="@style/DaoCardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/DaoCardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_controls" />

                    <RadioGroup
                        android:id="@+id/control_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/control_gamepad"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_control_gamepad" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/control_touch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_control_touch" />
                    </RadioGroup>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_control_hint"
                        android:textAppearance="?attr/textAppearanceBodySmall" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Advanced, folded. -->
            <com.google.android.material.card.MaterialCardView
                style="@style/DaoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    style="@style/DaoCardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/advanced_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/DaoCardTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_advanced" />

                        <ImageView
                            android:id="@+id/advanced_chevron"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_expand"
                            app:tint="@color/dao_red_dark" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/advanced"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/setting_sysmem"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />

                        <Spinner
                            android:id="@+id/sysmem"
                            android:layout_width="match_parent"
                            android:layout_height="48dp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/diagnostics"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/setting_diagnostics" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_diagnostics_help"
                            android:textAppearance="?attr/textAppearanceBodySmall" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/settings_env"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/settings_env_help"
                            android:textAppearance="?attr/textAppearanceBodySmall" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="@string/settings_env_hint">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/env"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:gravity="top"
                                android:inputType="textMultiLine|textNoSuggestions"
                                android:minLines="2"
                                android:textSize="13sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
