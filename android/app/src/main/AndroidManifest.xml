<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="internalOnly">

    <uses-feature android:name="android.hardware.vulkan.level" android:version="1" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Only the GitHub link's check for a newer release (api.github.com), once a day. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Building a game on the phone (BuildService): in the foreground, with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The games' data in /sdcard/XDroid360, the same folder for every build of the app (Android 11+:
         the launcher asks once; without it the data stays in the app's own folder). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- The bug report's "Send by email" lists the mail apps (package visibility). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="application/zip" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:largeHeap="true"
        android:extractNativeLibs="true"
        android:theme="@style/AppTheme"
        android:enableOnBackInvokedCallback="false"
        android:hardwareAccelerated="true">

        <!-- The back button is the game's (SDL maps it to a key). -->
        <meta-data android:name="SDL_ENV.SDL_ANDROID_TRAP_BACK_BUTTON" android:value="1" />

        <!-- The launcher: the installed games, adding a game package, each game's settings. -->
        <activity
            android:name=".LauncherActivity"
            android:label="@string/app_name"
            android:theme="@style/LauncherTheme"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ModsActivity"
            android:theme="@style/LauncherTheme"
            android:exported="false" />
        <activity
            android:name=".WikiActivity"
            android:theme="@style/LauncherTheme"
            android:exported="false" />
        <activity
            android:name=".BugReportActivity"
            android:theme="@style/LauncherTheme"
            android:exported="false" />
        <activity
            android:name=".PadEditorActivity"
            android:screenOrientation="landscape"
            android:theme="@style/AppTheme"
            android:exported="false" />
        <activity
            android:name=".InstanceActivity"
            android:theme="@style/LauncherTheme"
            android:exported="false" />
        <activity
            android:name=".BuildActivity"
            android:theme="@style/LauncherTheme"
            android:exported="false" />
        <service
            android:name=".BuildService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- Shares copies of logs (InstanceActivity). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".GameActivity"
            android:label="@string/app_name"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:screenOrientation="landscape"
            android:exported="true">
            <!-- A USB gamepad plugged in while the game runs. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
        </activity>
    </application>
</manifest>
