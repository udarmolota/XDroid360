--- a/DAORecomp/gpu/video.cpp
+++ b/DAORecomp/gpu/video.cpp
@@ -436,6 +436,19 @@ DAO_IMPORT_AS(VdSwap, dao::imp::VdSwap)
 // 2xMSAA (the upscaler failing, or SMAA turned off) from one frame to the next.
 constexpr dao::kernel::GameAddress kSceneMsaaType{ 0x8316E35C, 0x8323E83C }; // D3DMULTISAMPLE_TYPE, 0: none
 constexpr dao::kernel::GameAddress kSceneTileRects{ 0x82144D64, 0x8215E5A8 }; // D3DRECT {x1, y1, x2, y2}[2]
+// With 2xMSAA the scene's colour and depth share the 10 MB of EDRAM: width * rows * 2 samples *
+// (4 + 4) bytes. The engine's 1280x512 first tile fills it exactly. A wider display gets fewer rows
+// in the first tile (1600: 400, so 320 are left for the second), in whole 16-row EDRAM tiles; the
+// colour must not spill into the depth that starts at the same EDRAM base as for 1280 (it showed
+// as black bands). Two tiles are enough up to about 1780 pixels wide.
+static uint32_t SceneFirstTileRows(uint32_t displayWidth)
+{
+    if (displayWidth <= 1280)
+        return 512;
+    const uint32_t rows = (1280u * 512u / displayWidth) & ~15u;
+    return rows < 16 ? 16 : rows;
+}
