 static void SceneTilesHook(PPCContext& ctx, uint8_t* base, PPCFunc* original)
 {
     dao::ui::ApplyEngineGraphicsOptions(base);
@@ -444,6 +457,13 @@ static void SceneTilesHook(PPCContext& ctx, uint8_t* base, PPCFunc* original)
     if (ctx.r3.s32 != 2)
         return;
     const uint32_t rects = kSceneTileRects.Get();
+    // A widescreen display (DaoSceneWidthMidAsmHook): the tiles are as wide as the display.
+    const uint32_t displayWidth = dao::gpu::g_video.displayWidth;
